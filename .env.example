# --- Discord ---
DISCORD_TOKEN=your-bot-token-here

# --- Web panel ---
WEB_PASSWORD=pick-something-long-and-random
PORT=3000
# Who can open the panel. 127.0.0.1 = only this computer (default).
# 0.0.0.0 = any device on your home network (still needs the password).
HOST=127.0.0.1

# --- Stream alerts (optional) ---
# Twitch: dev.twitch.tv/console > Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube: Google Cloud Console > enable "YouTube Data API v3" > Credentials > API key
YOUTUBE_API_KEY=
# How often to check if you're live (seconds, minimum 30)
POLL_SECONDS=60

# --- Logs (optional) ---
# How many recent messages to remember (in memory only) so deleted/edited messages can be shown
LOG_CACHE_SIZE=10000

# --- Music (optional) ---
# Commands start with this word, e.g. "ryn play <song>"
MUSIC_PREFIX=ryn
# Most songs read from one playlist link
MUSIC_MAX_PLAYLIST=100
# A YouTube Mix link (list=RD…) never ends, so only this many songs are queued
MUSIC_MIX_SIZE=20
# Refuse single videos longer than this many minutes (0 = no limit)
MUSIC_MAX_TRACK_MINUTES=240
# Leave the voice channel after this many idle minutes (0 = never)
MUSIC_IDLE_MINUTES=5
# If YouTube insists on a login, export a cookies.txt into the data folder and uncomment (see deploy/MUSIC.md)
# YTDLP_COOKIES=/app/data/cookies.txt
# Links from sites besides YouTube, Spotify, SoundCloud and Bandcamp (comma-separated)
# MUSIC_EXTRA_HOSTS=twitch.tv
